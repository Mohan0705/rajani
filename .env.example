# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Saree Business Settings Configuration Defaults
VITE_WHATSAPP_NUMBER="919876543210"
VITE_INSTAGRAM_URL="https://instagram.com/sareeboutique"
VITE_GOOGLE_MAPS_URL="https://maps.google.com"

# Supabase Credentials (Optional - app automatically uses server-side embedded store if unconfigured)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# Admin Authentication Secret Key
ADMIN_SECRET_KEY="saree-admin-secret-jwt-key"
